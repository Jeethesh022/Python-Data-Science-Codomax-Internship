        "print(\"Std      :\", round(cv_mae.std(), 2))\n",
        "\n",
        "print(\"\\nRMSE:\")\n",
        "print(\"Each fold:\", np.round(cv_rmse, 2))\n",
        "print(\"Mean     :\", round(cv_rmse.mean(), 2))\n",
        "print(\"Std      :\", round(cv_rmse.std(), 2))\n",
        "\n",
